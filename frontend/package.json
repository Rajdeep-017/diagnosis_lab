{
  "name": "lab-report-portal-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:contrast && tsc -b && vite build && node scripts/compress-assets.mjs && npm run check:bundle",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:real-backend": "node scripts/test-real-backend.mjs",
    "test:all": "npm test && npm run test:e2e",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "test:lighthouse": "npx --yes @lhci/cli@0.14.0 autorun"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-telugu": "^5.3.0",
    "@tanstack/react-query": "^5.56.0",
    "i18next": "^23.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  }
}
